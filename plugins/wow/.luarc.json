{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "io": "disable",
    "os": "disable",
    "package": "disable",
    "debug": "disable"
  },
  "workspace.library": [
    "dev/tools/vscode-wow-api/Annotations/Core"
  ],
  "workspace.ignoreDir": [
    "dev/tools",
    "dev/harness",
    "dev/tests",
    "scripts",
    "skills"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "Agentcraft",
    "AgentcraftDB",
    "AgentcraftCharDB",
    "SLASH_AGENTCRAFT1",
    "SLASH_AGENTCRAFT2"
  ],
  "diagnostics.disable": [
    "lowercase-global"
  ]
}
